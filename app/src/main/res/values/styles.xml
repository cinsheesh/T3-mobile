<resources>
    <style name="GayaJudul">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/ukuran_teks_judul</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">#4A5BFF</item> <!-- Biru sedikit beda -->
        <item name="android:gravity">center</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="GayaLabel">
        <item name="android:textSize">@dimen/ukuran_teks_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#444</item>
    </style>

    <style name="GayaTombol">
        <item name="android:textSize">@dimen/ukuran_teks_tombol</item>
        <item name="android:backgroundTint">#4A5BFF</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GayaHasil">
        <item name="android:textSize">@dimen/ukuran_teks_hasil</item>
        <item name="android:background">#F0F0F0</item>
        <item name="android:padding">@dimen/padding_output</item>
        <item name="android:textColor">#222222</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>